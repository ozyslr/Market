rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // -------------------------------------------------------------------------
    // GLOBALS & HELPERS
    // -------------------------------------------------------------------------
    
    function isSignedIn() { return request.auth != null; }
    function userId() { return request.auth.uid; }
    function userEmail() { return request.auth.token.email; }
    function isVerified() { return isSignedIn(); } // Adjusted for preview env

    // Admin check: either special email or 'admin' role in users collection
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.keys().hasAll(['email']) && request.auth.token.email == 'ozyslr@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(userId())) && 
         get(/databases/$(database)/documents/users/$(userId())).data.role == 'admin')
      );
    }

    function isModerator() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(userId())) && 
             get(/databases/$(database)/documents/users/$(userId())).data.role == 'moderator';
    }

    function isSeller() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(userId())) && 
             get(/databases/$(database)/documents/users/$(userId())).data.role == 'seller';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // -------------------------------------------------------------------------
    // ENTITY VALIDATION HELPERS
    // -------------------------------------------------------------------------

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'role']) &&
             data.id == userId() &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.role in ['buyer', 'seller', 'admin', 'moderator'] &&
             data.preferences is map;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'sellerId', 'title', 'categoryId', 'price']) &&
             data.title is string && data.title.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             data.sellerId is string &&
             (exists(/databases/$(database)/documents/sellers/$(data.sellerId)) || 
              existsAfter(/databases/$(database)/documents/sellers/$(data.sellerId)));
    }

    function isValidSeller(data) {
      return data.keys().hasAll(['id', 'userId', 'storeName', 'slug']) &&
             (data.userId == userId() || isAdmin()) &&
             data.storeName is string && data.storeName.size() <= 100 &&
             data.slug.matches('^[a-z0-9-]+$');
    }

    // -------------------------------------------------------------------------
    // COLLECTION RULES
    // -------------------------------------------------------------------------

    // Default Deny
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // System Connection Test
    match /system/connection-test {
      allow read: if true;
    }

    // Categories (Publicly readable)
    match /categories/{cid} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users
    match /users/{uid} {
      allow get: if isSignedIn() && (userId() == uid || isAdmin() || isModerator());
      allow list: if isAdmin();
      allow create: if isVerified() && isValidUser(incoming()) && uid == userId();
      allow update: if isVerified() && (
        (uid == userId() &&
         incoming().id == existing().id &&
         incoming().role == existing().role &&
         !('stripeCustomerId' in incoming().keys() ||
           'defaultPaymentMethodId' in incoming().keys() ||
           'defaultPaymentMethodLast4' in incoming().keys() ||
           'defaultPaymentMethodBrand' in incoming().keys())) ||
        isAdmin()
      );
    }

    // Sellers
    match /sellers/{sellerId} {
      allow read: if true;
      allow create: if isVerified() && (isAdmin() || (incoming().userId == userId() && isValidSeller(incoming())));
      allow update: if isVerified() && (
        (existing().userId == userId() && incoming().userId == existing().userId) || 
        isAdmin()
      );
    }

    // Products
    match /products/{pid} {
      allow read: if true;
      allow create: if isVerified() && (
        isAdmin() || 
        (isSeller() && isValidProduct(incoming()) && get(/databases/$(database)/documents/sellers/$(incoming().sellerId)).data.userId == userId())
      );
      allow update: if isVerified() && (
        isAdmin() ||
        (get(/databases/$(database)/documents/sellers/$(existing().sellerId)).data.userId == userId() && isValidProduct(incoming()))
      );
      allow delete: if isAdmin() || (get(/databases/$(database)/documents/sellers/$(existing().sellerId)).data.userId == userId());
    }

    // Orders
    match /orders/{oid} {
      allow get: if isSignedIn() && (resource.data.buyerId == userId() || isAdmin() || isModerator());
      allow list: if isSignedIn() && (resource.data.buyerId == userId() || isAdmin() || isModerator());
      allow create: if isSignedIn() && incoming().buyerId == userId();
      allow update: if isAdmin() || isModerator();
    }

    // OrderSets (Walking Skeleton) — server-side writes via Admin SDK
    match /orderSets/{orderSetId} {
      allow read: if isSignedIn() && (resource.data.userId == userId() || isAdmin());
      allow create: if isSignedIn() && incoming().userId == userId();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // SubOrders — only accessible via server-side API (never direct client read)
    match /subOrders/{subOrderId} {
      allow read: if false;     // Must read through GET /api/orders/:orderSetId
      allow create: if false;   // Only via orderSet transaction from server
      allow update: if isAdmin(); // Admin tools only
      allow delete: if false;
    }

    // Commission Rules — admin-only writes, authenticated reads
    match /commissionRules/{ruleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Activity Logs
    match /activity_logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
    }

    // Carts (user owns their cart doc)
    match /carts/{userId} {
      allow get, create, update: if isSignedIn() && userId == userId();
      allow delete: if isSignedIn() && userId == userId();
    }

    // Cart reminders (server-side only via Admin SDK — no client access)
    match /cart_reminders/{reminderId} {
      allow read, write: if false;
    }

    // Mail (Firebase Trigger Email — server-side only)
    match /mail/{mailId} {
      allow create: if isSignedIn(); // extension writes, but user can trigger
      allow read, write: if false;
    }

    // Events (analytics)
    match /events/{eventId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
    }

    // Chat Sessions (live support)
    match /chat_sessions/{sessionId} {
      allow read: if isSignedIn() && (resource.data.userId == userId() || isAdmin());
      allow create: if isSignedIn() && incoming().userId == userId();
      allow update: if isSignedIn() && (
        (resource.data.userId == userId() && incoming().userId == resource.data.userId) ||
        isAdmin()
      );
      allow delete: if isAdmin();

      // Chat Messages (subcollection)
      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/chat_sessions/$(sessionId)).data.userId == userId() ||
          isAdmin()
        );
        allow create: if isSignedIn() && (
          (get(/databases/$(database)/documents/chat_sessions/$(sessionId)).data.userId == userId() && incoming().role == 'user') ||
          (isAdmin() && incoming().role == 'admin')
        );
        allow update: if isAdmin();
        allow delete: if false;
      }
    }
  }
}
