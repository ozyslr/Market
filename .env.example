# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# STRIPE: Required for real payment processing.
# Configure this in the Secrets panel in AI Studio.
STRIPE_SECRET_KEY="YOUR_STRIPE_SECRET_KEY"
VITE_STRIPE_PUBLISHABLE_KEY="YOUR_STRIPE_PUBLISHABLE_KEY"

# EXCHANGE_RATE_API: Used for live multi-currency conversion in the footer/ticker.
VITE_EXCHANGE_RATE_API_KEY="YOUR_EXCHANGE_RATE_API_KEY"

# NOTE: Role-based access control now uses Firebase Custom Claims (not Firestore reads).
#   - Roles (admin/seller/buyer) are set via POST /api/admin/set-claims (verifyAdmin).
#   - The old hardcoded admin check for ozyslr@gmail.com has been removed (D-12).
#   - Admin users must have { role: "admin" } in their custom claims.
#   - Seller users must have { role: "seller", sellerId: "..." } in custom claims.
#   - See firestore.rules for per-collection security rules using request.auth.token.role.

# TYPESENSE: Search engine for typo-tolerant full-text search.
# Self-host on a VPS or use Typesense Cloud.
TYPESENSE_API_KEY="YOUR_TYPESENSE_API_KEY"
TYPESENSE_HOST="localhost"
TYPESENSE_PORT="8108"
TYPESENSE_PROTOCOL="https"
TYPESENSE_SYNC_SECRET="YOUR_SYNC_SECRET"

# TYPESENSE (client-side — VITE_ prefix required for Vite)
VITE_TYPESENSE_API_KEY=
VITE_TYPESENSE_HOST=localhost
VITE_TYPESENSE_PORT=8108
VITE_TYPESENSE_PROTOCOL=https