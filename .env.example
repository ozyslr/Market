# ═══════════════════════════════════════════════════════════════════════════
# SECURITY: Never commit real .env files. .env* is gitignored.
# This .env.example is a template — all values below are placeholders.
# In production, inject secrets via environment (not files on disk).
# ═══════════════════════════════════════════════════════════════════════════

# GEMINI_API_KEY: Required for Gemini AI (server-side only).
# Used by server/routes/gemini.ts proxy — NEVER exposed to client bundle.
# Configure this via environment or the Secrets panel in AI Studio.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# STRIPE: Required for real payment processing.
# Configure this in the Secrets panel in AI Studio.
STRIPE_SECRET_KEY="YOUR_STRIPE_SECRET_KEY"
VITE_STRIPE_PUBLISHABLE_KEY="YOUR_STRIPE_PUBLISHABLE_KEY"

# EXCHANGE_RATE_API: Used for live multi-currency conversion in the footer/ticker.
VITE_EXCHANGE_RATE_API_KEY="YOUR_EXCHANGE_RATE_API_KEY"

# STRIPE_WEBHOOK_SECRET: Required for Stripe webhook signature verification.
# Get from: Stripe Dashboard > Developers > Webhooks > [Endpoint] > Signing secret
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# FIREBASE_SERVICE_ACCOUNT_B64: Required for server-side Firestore operations (webhooks).
# Base64-encoded Firebase Admin service account JSON key.
# Get from: Firebase Console > Project Settings > Service Accounts > Generate Key
# Encode: base64 -w0 path/to/service-account.json
FIREBASE_SERVICE_ACCOUNT_B64=""

# IYZICO: Required for Turkey payment processing (iyzico).
# Sandbox: sandbox-xxx / https://sandbox.iyzipay.com
# Production: https://api.iyzipay.com
IYZICO_API_KEY="sandbox-xxx"
IYZICO_SECRET_KEY="sandbox-xxx"
IYZICO_BASE_URL="https://sandbox.iyzipay.com"

# ANALYTICS: Third-party analytics IDs (all optional — consent-first)
# GA4: Google Analytics 4 Measurement ID (preferred: VITE_GA4_MEASUREMENT_ID)
VITE_GA4_MEASUREMENT_ID="G-XXXXXXXXXX"
# GA4: Legacy alias (fallback if VITE_GA4_MEASUREMENT_ID is not set)
VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
# Meta/Facebook Pixel ID
VITE_META_PIXEL_ID="000000000000000"
# TikTok Pixel ID
VITE_TIKTOK_PIXEL_ID="XXXXXXXX"

# SENTRY: Required for error monitoring.
# Get from: Sentry > Settings > Projects > [Project] > Client Keys (DSN)
VITE_SENTRY_DSN="https://xxx@xxx.ingest.de.sentry.io/xxx"

# CRON_SECRET: Zamanlanmış/otomatik endpoint'leri korur.
# Etkilediği endpoint'ler:
#   POST /api/process-scheduled-payouts
#   POST /api/abandoned-cart/check
# Harici cron servisi (örn. cron-job.org) istek başlığında göndermeli:
#   X-Cron-Secret: <CRON_SECRET>
# Güçlü rastgele bir değer üretin: openssl rand -hex 32
CRON_SECRET=""
