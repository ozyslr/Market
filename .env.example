# =============================================================================
# Benim Olan (Mercora) â€” Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Server-side
# ---------------------------------------------------------------------------

# --- Stripe (Payment Gateway â€” Primary) ---
# Required for payment processing. Get keys from Stripe Dashboard.
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# --- Firebase Admin (Server-side Auth + Firestore) ---
# Base64-encoded Firebase service account JSON key.
# Generate from Firebase Console > Project Settings > Service Accounts > Generate new private key.
# Then: base64 -w0 path/to/serviceAccount.json
FIREBASE_SERVICE_ACCOUNT_B64=base64_encoded_service_account_json

# --- Twilio (SMS OTP Verification) ---
# Required for phone number OTP verification flow (buyer + seller KYC).
# Get from Twilio Console > Account Info + Verify Service.
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_VERIFY_SID=your_twilio_verify_service_sid_here

# --- Google Gemini AI ---
# Required for AI-powered features (server-side).
# Get from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Iyzico (Turkish Payment Gateway) ---
# Required for Turkish market payment processing.
# Get from Iyzico Dashboard: https://sandbox.iyzipay.com (sandbox) or https://merchant.iyzipay.com (live).
IYZICO_API_KEY=your_twilio_auth_token_here
IYZICO_SECRET_KEY=your_twilio_auth_token_here
# OPTIONAL: Iyzico base URL. Defaults to sandbox. Set to https://api.iyzipay.com for production.
# IYZICO_BASE_URL=https://sandbox.iyzipay.com

# --- Resend (Transactional Email) ---
# Required for sending transactional emails (order confirmations, abandoned cart, etc.).
# Get from Resend: https://resend.com/
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Cron Job Authentication ---
# Secret token for cron job endpoints (passed via x-cron-secret header).
# Generate with: openssl rand -hex 32
CRON_SECRET=generate_a_random_secret_here

# --- Application URL ---
# The public URL of the application. Used for CORS, redirect URLs, email links, etc.
APP_URL=https://benimolan.com

# --- Typesense Sync (Server-side) ---
# OPTIONAL: Server-side secret for Typesense index rebuild cron endpoints.
# Defaults to 'dev-secret' when unset.
# TYPESENSE_SYNC_SECRET=your_secret_here

# --- Shipping (EasyPost) ---
# OPTIONAL: Webhook secret for carrier tracking updates from EasyPost.
# EASYPOST_WEBHOOK_SECRET=ezwhsec_xxxxxxxx

# --- Environment ---
# Set to 'production' for production deployments.
# NODE_ENV=production

# --- Logging ---
# OPTIONAL: pino log level ('debug', 'info', 'warn', 'error').
# Defaults to 'info' in production, 'debug' in development.
# LOG_LEVEL=debug

# --- Email From Address ---
# OPTIONAL: Custom "From" address for transactional emails.
# Defaults to: Benim Olan <noreply@benimolan.com>
# EMAIL_FROM=Benim Olan <noreply@benimolan.com>

# --- Port ---
# OPTIONAL: Server port. Defaults to 3000.
# PORT=3000

# ---------------------------------------------------------------------------
# Client-side (VITE_ prefix â€” bundled into frontend at build time)
# ---------------------------------------------------------------------------

# --- Stripe (Client) ---
# Required for Stripe Elements / Payment Element in the browser.
# Public publishable key from Stripe Dashboard.
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# --- Sentry (Error Monitoring) ---
# OPTIONAL: Frontend crash and error reporting. Sentry is silently disabled when not set.
# Get from Sentry: https://sentry.io/ > Settings > Projects > Client Keys (DSN).
# VITE_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxx@xxxxxxxx.ingest.de.sentry.io/xxxxxxxx

# --- Exchange Rate API ---
# OPTIONAL: Live multi-currency conversion (footer, price display).
# Exchange rate features degrade gracefully when unset (shows TRY only).
# Get free key from: https://www.exchangerate-api.com
# VITE_EXCHANGE_RATE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Typesense (Full-text Search) ---
# OPTIONAL: Typo-tolerant full-text search engine (Firestore fallback when unset).
# VITE_TYPESENSE_API_KEY=your_twilio_auth_token_here
# VITE_TYPESENSE_HOST=localhost
# VITE_TYPESENSE_PORT=8108
# VITE_TYPESENSE_PROTOCOL=https

# --- Typesense Sync (Client-side) ---
# OPTIONAL: Used by productService to trigger index updates from the frontend.
# VITE_TYPESENSE_SYNC_SECRET=your_secret_here

# --- Google Analytics 4 ---
# OPTIONAL: GA4 measurement ID for analytics tracking.
# VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Universal Analytics (Legacy) ---
# OPTIONAL: Legacy Google Analytics property ID.
# VITE_GA_MEASUREMENT_ID=UA-XXXXXXXXX-X

# --- Meta (Facebook) Pixel ---
# OPTIONAL: Meta Pixel ID for conversion tracking and retargeting.
# VITE_META_PIXEL_ID=xxxxxxxxxxxxxxxxxxxxxxxx

# --- TikTok Pixel ---
# OPTIONAL: TikTok Pixel ID for ad tracking.
# VITE_TIKTOK_PIXEL_ID=xxxxxxxxxxxxxxxxxxxxxxxx

# --- API Base URL ---
# OPTIONAL: Override API base URL for one-click checkout service.
# Defaults to '' (relative URLs â€” same origin).
# VITE_API_URL=

# --- Gemini AI (Client-side) ---
# OPTIONAL: Client-side AI features (separate from server-side GEMINI_API_KEY).
# Both vars share the same key value but the VITE_ prefix controls client exposure.
# VITE_GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# Quick-start for local development
# =============================================================================
# 1. cp .env.example .env
# 2. Fill STRIPE_SECRET_KEY + STRIPE_WEBHOOK_SECRET from Stripe Dashboard
# 3. Fill FIREBASE_SERVICE_ACCOUNT_B64 (base64-encode your service account JSON)
# 4. Fill VITE_STRIPE_PUBLISHABLE_KEY from Stripe Dashboard
# 5. Set APP_URL=http://localhost:3000 for local dev
# 6. Set CRON_SECRET to any random string
# 7. All other vars are optional â€” features degrade gracefully when unset
# =============================================================================
