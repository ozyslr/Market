rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── KYC documents — deny ALL client SDK access (T-03-01) ─────────────────
    // Admin SDK bypasses these rules (used by kycService.ts for signed URLs).
    match /kyc/{sellerId}/{docId} {
      allow read, write: if false;
    }

    // ── Product images — public read; sellers write only under products/{uid}/ ─
    // Previously any signed-in user (incl. anonymous guests) could overwrite any
    // product image. Legacy root-level files stay readable but are now immutable
    // for non-admins.
    function isValidImage() {
      return request.resource.size < 10 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
    }
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                    && request.auth.token.role == 'admin'
                    && (request.resource == null || isValidImage());
    }
    match /products/{ownerId}/{file=**} {
      allow write: if request.auth != null
                    && request.auth.uid == ownerId
                    && request.auth.token.role == 'seller'
                    && (request.resource == null || isValidImage());
    }

  }
}
