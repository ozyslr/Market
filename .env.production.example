# ─── Production Environment Variables ──────────────────────────────────────
# Copy to .env and fill in production values
# NEVER commit .env to git

# ── Core ───────────────────────────────────────────────────────────────────
NODE_ENV=production
APP_URL=https://benimolan.com
PORT=3000

# ── Firebase ───────────────────────────────────────────────────────────────
# Same project, different API key if needed
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin SDK (server-side only)
GOOGLE_APPLICATION_CREDENTIALS=service-account.json

# ── Stripe (Production) ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_
STRIPE_WEBHOOK_SECRET=whsec_
# Stripe Tax — enable in Stripe Dashboard, then set:
# STRIPE_TAX_ENABLED=true

# ── Iyzico (Production) ────────────────────────────────────────────────────
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://api.iyzipay.com

# ── Typesense ──────────────────────────────────────────────────────────────
# Cloud or self-hosted. Provision: scripts/provision-typesense.mjs
TYPESENSE_API_KEY=
TYPESENSE_HOST=
TYPESENSE_PORT=443
TYPESENSE_PROTOCOL=https
TYPESENSE_SYNC_SECRET=

# ── E-Fatura ───────────────────────────────────────────────────────────────
# Paraşüt or Logo API for Turkish e-invoice
EFATURA_API_URL=
EFATURA_API_KEY=

# ── Email (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Benim Olan <noreply@benimolan.com>

# ── SMS (Twilio) ───────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
VITE_TWILIO_VERIFY_SID=

# ── AI ─────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Monitoring (Sentry) ────────────────────────────────────────────────────
VITE_SENTRY_DSN=
