{
  "root": true,
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "extends": ["eslint:recommended"],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": { "jsx": true }
  },
  "rules": {
    "no-unused-vars": "off",
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "no-debugger": "error"
  },
  "ignorePatterns": ["dist/", "node_modules/", "mobile/", "mercora-next/", "functions/", "*.js", "*.mjs", "*.cjs"],
  "settings": {
    "react": { "version": "detect" }
  }
}
